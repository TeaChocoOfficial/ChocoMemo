    "guide": {
        "badge": "指南",
        "tag": "用户手册",
        "title": "如何使用 ChocoMemo",
        "subtitle": "快速了解应用：每个区域的作用，以及让第一次学习顺利进行的使用顺序。",
        "quickStart": {
            "title": "四个步骤，一次学习",
            "hint": "读一张表，练习它，然后复习所学内容。ChocoMemo 的其他功能都只是这三个步骤的变体。"
        },
        "steps": {
            "step1": {
                "title": "选择语言",
                "hint": "首页列出了所有目标语言。选择一种即可打开其词汇卡组，选择会记录在此设备上。"
            },
            "step2": {
                "title": "读表",
                "hint": "浏览你正在学习的文字字符表，点击任意字形即可听它发音。"
            },
            "step3": {
                "title": "练习",
                "hint": "针对所选字符的限时选择题回合。设置计时器、题目数量和分组以匹配你的水平。"
            },
            "step4": {
                "title": "复习单词",
                "hint": "闪卡会按计划带回你学过的词汇，让任何内容都不会流失。"
            }
        },
        "sections": {
            "title": "各部分的作用",
            "hint": "应用的每个区域一张卡片。每张卡片直接链接到它描述的页面。",
            "landing": {
                "title": "首页",
                "hint": "入口：应用是什么，以及它教授哪些语言。",
                "point1": "每种目标语言都列为整行 — 选择一种开始。",
                "point2": "你选择的语言会记录在设备上，并成为当前目标。",
                "point3": "没有注册墙：创建账户前即可使用字符表和卡组。"
            },
            "hub": {
                "title": "学习中心",
                "hint": "选择语言后进入的概览页。",
                "point1": "字符 — 每种文字一个磁贴，以字形本身为主。",
                "point2": "练习 — 字符练习列表，每项一行。",
                "point3": "卡组 — 学习（词汇、阅读）、练习（复习、考试）以及用于编辑的管理行。"
            },
            "charts": {
                "title": "字符表",
                "hint": "某种文字的参考视图，每个字符都有声音。",
                "point1": "假名（日语）、拉丁字母（英语）和泰文目前已经实现。",
                "point2": "每张表都分组显示 — 假名分为清音、浊音和拗音；字母表分为元音和辅音。",
                "point3": "点击字符即可听发音。语音跟随目标语言，而不是界面语言。",
                "point4": "朗读顺序会带你浏览整张表，并记住你读到哪里。"
            },
            "drill": {
                "title": "字符练习",
                "hint": "快速的选择题回合，把辨认变成记忆。",
                "point1": "切换字符分组和题目数量，从全部到少量。",
                "point2": "每题计时器带倒计时条，以及可选的自动前进。",
                "point3": "游戏过程中实时显示正确 / 错误 / 超时计数。",
                "point4": "结束时：分数等级、每道答案的分析和重玩按钮。"
            },
            "decks": {
                "title": "词汇、阅读、复习和考试",
                "hint": "共享同一个卡组列表的四项功能 — 它们只在打开卡组后发生的事情上不同。",
                "point1": "词汇卡组存放单词；阅读卡组存放阅读材料。",
                "point2": "复习把卡组变成按间隔计划安排的闪卡。",
                "point3": "考试把卡组变成选择题测试。",
                "point4": "工具栏按目标语言筛选，排序、密度和来源会记录在设备上。"
            },
            "edit": {
                "title": "编辑卡组",
                "hint": "一个编辑器适用于所有卡组类型，位于可停靠面板的全屏工作区中。",
                "point1": "用于卡组列表、编辑器、预览、检查器和设置的面板。",
                "point2": "自行布置：拖动、调整大小、固定标签页或重置布局。",
                "point3": "在手机上，同样的面板会变成带滑出菜单的标签栏。"
            },
            "voice": {
                "title": "语音和外观",
                "hint": "决定应用声音和外观的设置。",
                "point1": "主题：选择浅色或深色调色板之一，应用会随之变化。",
                "point2": "语音：选择由哪个已安装语音朗读字符，并配有预览按钮。",
                "point3": "界面：切换界面语言，并隐藏导航栏以获得无干扰视图。"
            },
            "account": {
                "title": "账户和社区",
                "hint": "账户功能所在的位置。",
                "point1": "登录或创建账户以访问你的个人资料和设置。",
                "point2": "你的公开资料可通过名称标签访问，因此可以分享。",
                "point3": "云同步和社区卡组即将推出。"
            }
        },
        "action": {
            "open": "打开",
            "comingSoon": "即将推出"
        }
    },
