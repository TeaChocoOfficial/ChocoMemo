{
	"name": "choco-memo-server",
	"version": "0.0.2",
	"description": "",
	"author": "TeaChoco",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"fm": "tsx scripts/format.ts",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"dev": "nodemon",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.2",
		"@fastify/multipart": "^10.1.1",
		"@fastify/static": "^10.1.3",
		"@nestjs/cache-manager": "^12.0.0",
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/jwt": "^12.0.1",
		"@nestjs/mongoose": "^12.0.0",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-fastify": "^12.0.1",
		"@nestjs/platform-socket.io": "^12.0.1",
		"@nestjs/swagger": "^12.0.1",
		"@nestjs/websockets": "^12.0.1",
		"@socket.io/admin-ui": "^0.5.1",
		"argon2": "^0.44.0",
		"chalk": "^5.6.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"fastify": "5.12.1",
		"glob": "^13.0.6",
		"joi": "^18.2.8",
		"mongoose": "^9.9.5",
		"nodemailer": "^10.0.10",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.3",
		"swagger-themes": "^1.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^12.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.1",
		"@types/nodemailer": "^8.0.2",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^6.0.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^16.5.0",
		"jest": "^30.5.1",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}